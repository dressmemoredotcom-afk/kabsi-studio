{
  "name": "kabsi-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Kabsi Studio: free, open-source promo video pipeline (Remotion, Kokoro TTS, FFmpeg).",
  "type": "module",
  "scripts": {
    "check": "node scripts/check-script.mjs",
    "typecheck": "tsc -p .",
    "lint": "eslint src --max-warnings=0",
    "build": "npm run typecheck && npm run lint && npm run check && remotion bundle src/index.ts --out-dir=.build-bundle --public-dir=assets",
    "studio": "remotion studio src/index.ts",
    "voice": "node scripts/voice.mjs 01",
    "voice:02": "node scripts/voice.mjs 02",
    "voice:03": "node scripts/voice.mjs 03",
    "audio": "node scripts/make-audio.mjs",
    "render": "node scripts/render.mjs 01",
    "render:02": "node scripts/render.mjs 02",
    "render:03": "node scripts/render.mjs 03",
    "roomy:assets": "node scripts/roomy-assets.mjs",
    "voice:04": "node scripts/voice.mjs 04",
    "prestudio": "node scripts/roomy-assets.mjs",
    "prerender:roomy": "node scripts/roomy-assets.mjs && node scripts/voice.mjs 04 && node scripts/check-script.mjs 04",
    "render:roomy": "remotion render RoomyApartmentReel out/roomy-downtown-275sqm.mp4",
    "postrender:roomy": "node scripts/master-audio.mjs out/roomy-downtown-275sqm.mp4"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.538",
    "@remotion/cli": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "kokoro-js": "1.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.538",
    "@types/react": "18.3.31",
    "eslint": "9.39.5",
    "typescript": "5.9.3"
  }
}
