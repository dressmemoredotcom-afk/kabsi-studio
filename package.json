{
  "name": "video-studio",
  "version": "0.1.0",
  "private": true,
  "description": "One video studio for two brands, Kabsi and Roomy Properties, sharing a brand-neutral engine (Remotion, Kokoro TTS, FFmpeg).",
  "type": "module",
  "scripts": {
    "kabsi:studio": "remotion studio kabsi/src/index.ts --public-dir=kabsi/public",
    "kabsi:check": "node kabsi/scripts/check.mjs",
    "kabsi:render": "node kabsi/scripts/render.mjs",
    "kabsi:voice": "node kabsi/scripts/voice.mjs",
    "kabsi:checklist": "node kabsi/scripts/checklist.mjs",
    "kabsi:voice-test": "node kabsi/scripts/voice-test.mjs",
    "roomy:studio": "node roomy/scripts/reel.mjs --studio",
    "roomy:check": "node roomy/scripts/check.mjs",
    "roomy:render": "node roomy/scripts/reel.mjs",
    "roomy:voice": "node roomy/scripts/voice.mjs",
    "roomy:assets": "node roomy/scripts/assets.mjs",
    "check": "npm run kabsi:check && npm run roomy:check && node engine/scripts/isolation.mjs && node engine/scripts/file-size.mjs",
    "typecheck": "tsc -p .",
    "lint": "eslint engine/src kabsi/src roomy/src --max-warnings=0",
    "build": "npm run typecheck && npm run lint && npm run check && remotion bundle kabsi/src/index.ts --out-dir=.bundles/kabsi --public-dir=kabsi/public && remotion bundle roomy/src/index.ts --out-dir=.bundles/roomy --public-dir=roomy/public"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.538",
    "@remotion/cli": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "kokoro-js": "1.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.538",
    "simple-icons": "16.36.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.538",
    "@types/react": "18.3.31",
    "eslint": "9.39.5",
    "typescript": "5.9.3"
  }
}
